generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Quest {
  id                String    @id @default(cuid())
  title             String
  note              String?
  location          String?
  kind              String
  deadline          DateTime
  expectedMinutes   Int       @default(30)
  category          String    @default("other")
  plannedStart      DateTime?
  importance        Int       @default(2)
  carryoverCount    Int       @default(0)
  status            String
  recurrenceJson    String?
  lastCarryoverDate String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  ownerId           String    @default("local")
}

model StudyPlan {
  id           String       @id @default(cuid())
  examName     String
  subject      String
  examDate     DateTime     @db.Date
  scope        String
  progress     Int
  difficulty   Int
  dailyMinutes Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  ownerId      String       @default("local")
  blocks       StudyBlock[]

  @@index([ownerId, examDate])
}

model StudyBlock {
  id              String    @id @default(cuid())
  studyPlanId     String
  date            DateTime  @db.Date
  stage           String
  title           String
  durationMinutes Int
  sequence        Int
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  studyPlan       StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId, date, status])
}

model CalendarBlock {
  id            String   @id @default(cuid())
  externalId    String
  calendarId    String?
  googleEventId String?
  title         String
  start         DateTime
  end           DateTime
  updatedAt     DateTime @updatedAt
  ownerId       String   @default("local")

  @@unique([ownerId, externalId])
}

model Settings {
  id                            String  @id @default(cuid())
  ownerId                       String  @unique @default("local")
  weekdayStart                  String  @default("09:00")
  weekdayEnd                    String  @default("22:00")
  weekendStart                  String  @default("10:00")
  weekendEnd                    String  @default("22:00")
  defaultView                   String  @default("list")
  timeZone                      String  @default("Asia/Seoul")
  theme                         String  @default("system")
  twoWaySync                    Boolean @default(false)
  googleImportMode              String? @default("all")
  selectedGoogleCalendarIdsJson String  @default("[]")
  notificationPromptCompleted   Boolean @default(false)
  browserNotificationsEnabled   Boolean @default(false)
  reminderMinutes               Int     @default(10)
}

model Notification {
  id          String    @id @default(cuid())
  kind        String
  questId     String
  message     String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  deliveredAt DateTime?
  ownerId     String    @default("local")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String   @default("local")

  @@unique([ownerId, endpoint])
}

model ReminderDelivery {
  id             String   @id @default(cuid())
  questId        String
  scheduledStart DateTime
  sentAt         DateTime @default(now())
  ownerId        String   @default("local")

  @@unique([ownerId, questId, scheduledStart])
}

model GoogleConnection {
  id                  String    @id @default(cuid())
  ownerId             String    @unique @default("local")
  accessToken         String?
  refreshToken        String?
  tokenExpiresAt      DateTime?
  scope               String?
  dedicatedCalendarId String?
  lastSyncedAt        DateTime?
  lastSyncError       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model GoogleEventMapping {
  id              String    @id @default(cuid())
  questId         String
  calendarId      String
  googleEventId   String
  googleUpdatedAt DateTime?
  updatedAt       DateTime  @updatedAt
  ownerId         String    @default("local")

  @@unique([ownerId, questId])
  @@unique([ownerId, googleEventId])
}

model GoogleCalendarCursor {
  id         String   @id @default(cuid())
  calendarId String
  syncToken  String?
  updatedAt  DateTime @updatedAt
  ownerId    String   @default("local")

  @@unique([ownerId, calendarId])
}

model User {
  id            String    @id @default(cuid())
  googleSubject String    @unique
  email         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  ownerId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}
